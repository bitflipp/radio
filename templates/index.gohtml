<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Radio Go Go</title>
    <link rel="icon" type="image/svg" href="/static/favicon.svg">
    <link rel="stylesheet" href="/static/index.css"/>
    <script src="/static/index.js"></script>
  </head>
  <body>
    <div class="controls">
      <input name="filter" autofocus />
    </div>
    <table>
      <tr>
        <th></th>
        <th>Time</th>
        <th>Artist</th>
        <th>Album</th>
        <th>Track</th>
        <th>Title</th>
      </tr>
      {{ range . }}
      <tr class="media" data-term="{{ .Artist }} {{ .Album }} {{ .Title }}">
        <td class="controls"><button data-action="toggle">[Play]</button></td>
        <td class="time">?</td>
        <td>{{ .Artist }}</td>
        <td>{{ .Album }}</td>
        <td>{{ .Track }}</td>
        <td>{{ .Title }}</td>
        <td class="audio"><audio src="/media/{{ .FileName }}" /></td>
      </tr>
      {{ end }}
    </table>
  </body>
</html>
