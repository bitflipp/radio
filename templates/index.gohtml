<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Radio Go Go</title>
    <link rel="icon" type="image/svg" href="/static/favicon.svg" />
    <link rel="stylesheet" href="/static/index.css" />
    <script src="/static/index.js"></script>
  </head>
  <body>
    <table class="controls">
      <tr>
        <td class="filter"><input type="text" name="filter" autofocus /></td>
        <td class="range"><input type="range" name="range" value="0" /></td>
        <td class="time"><input type="text" name="time" readonly /></td>
      </tr>
    </table>
    <table class="media">
      <tr>
        <th>Artist</th>
        <th>Album</th>
        <th>Track</th>
        <th>Title</th>
      </tr>
      {{ range . }}
      <tr class="media" data-term="{{ .Artist }} {{ .Album }} {{ .Title }}">
        <td class="artist">{{ .Artist }}</td>
        <td class="album">{{ .Album }}</td>
        <td class="track">{{ .Track }}</td>
        <td class="title">{{ .Title }}</td>
        <td class="audio"><audio src="/media/{{ .FileName }}" /></td>
      </tr>
      {{ end }}
    </table>
  </body>
</html>
